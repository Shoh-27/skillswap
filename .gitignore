# =========================
# Laravel + React .gitignore
# =========================

# -------------------------
# Laravel
# -------------------------
/vendor
/node_modules
/public/storage
/storage/*.key
/storage/app/public
/bootstrap/cache/*.php
/bootstrap/cache/packages.php
/bootstrap/cache/services.php

# Environment files
.env
.env.*
!.env.example

# Laravel logs
/storage/logs/*
*.log

# Laravel cache
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*

# PHPUnit
.phpunit.result.cache

# IDE files
/.idea
/.vscode
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Composer
/composer.lock

# -------------------------
# React / Node.js
# -------------------------
/node_modules
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Build folders
/dist
/build

# Vite
.vite

# React env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -------------------------
# Testing
# -------------------------
/coverage

# -------------------------
# Docker
# -------------------------
docker-data/
*.pid

# -------------------------
# Database
# -------------------------
*.sqlite

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp

# -------------------------
# Misc
# -------------------------
/public/hot
/public/storage
Homestead.json
Homestead.yaml

# -------------------------
# Optional: Ignore uploaded files
# -------------------------
/storage/app/uploads

# -------------------------
# Optional: Ignore generated assets
# -------------------------
/public/build